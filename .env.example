# Copia este archivo a .env y ajusta valores

# API Node (por defecto vacío = mismo origen; en dev Vite hace proxy a :4000)
VITE_API_URL=

# Orígenes permitidos para CORS (coma separada). En producción: tu dominio con https
# CORS_ORIGIN=https://yaprofe.com,https://www.yaprofe.com

# Servidor Express / MySQL (usar en la misma máquina o servidor)
PORT=4000
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=yaprofebolt

# Correo de soporte (opcional): enlace "Olvidé mi contraseña" abre el cliente de correo
# VITE_SUPPORT_EMAIL=soporte@tudominio.com

# URL pública si el servidor está detrás de proxy (opcional)
# PUBLIC_ORIGIN=https://tudominio.com
# Misma URL para enlaces en correos transaccionales (compra confirmada, etc.)
# APP_PUBLIC_URL=https://tudominio.com

# Correo transaccional (opcional; sin esto no se envían emails al confirmar pago)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="YaProFe <noreply@tudominio.com>"

# Web Push (opcional; sin esto la app funciona pero no hay clave VAPID)
# Genera par: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu@email.com
